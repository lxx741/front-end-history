---
import '../styles/global.css';
import type { TimelineYear, TimelineEvent } from '../types/timeline';
import timelineData from '../data/timeline.json';
import { CATEGORIES, IMPORTANCE } from '../data/config';
import QuickNav from '../components/QuickNav.astro';
import Background from '../components/Background.astro';

interface TimelineProps {
  years: TimelineYear[];
}

const years: TimelineYear[] = timelineData as TimelineYear[];

// Function to determine era color based on year
function getEraColor(year: number): string {
  if (year < 2000) return 'era-90s';
  if (year < 2010) return 'era-00s';
  if (year < 2020) return 'era-10s';
  return 'era-20s';
}

// Function to get importance size classes
function getImportanceClasses(importance: string): string {
  switch (importance) {
    case 'critical':
      return 'text-2xl md:text-3xl p-6 bg-gradient-to-br from-pink-500 to-purple-600 text-white shadow-2xl ring-4 ring-pink-200 animate-pulse-glow';
    case 'high':
      return 'text-xl md:text-2xl p-5 bg-gradient-to-br from-blue-500 to-cyan-600 text-white shadow-xl ring-2 ring-blue-200';
    case 'medium':
      return 'text-lg md:text-xl p-4 bg-white shadow-lg border-2 border-gray-200 hover:shadow-xl transition-shadow';
    case 'low':
      return 'text-base md:text-lg p-3 bg-gray-50 shadow-md hover:shadow-lg transition-shadow';
    default:
      return 'text-base p-3 bg-gray-50 shadow-md';
  }
}

function getCategoryIcon(event: TimelineEvent): string {
  return event.icon || '📅';
}
---

<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>前端发展史 - 互动时间轴</title>
  <meta name="description" content="从1990到2025，涵盖技术标准、框架、浏览器与重要里程碑的前端发展史互动时间轴。支持搜索、分类筛选与年份导航。">
  <link rel="canonical" href="https://lxx741.github.io/front-end-history/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="前端发展史 - 互动时间轴">
  <meta property="og:description" content="从1990到2025，涵盖技术标准、框架、浏览器与重要里程碑的前端发展史互动时间轴。">
  <meta property="og:url" content="https://lxx741.github.io/front-end-history/">
  <meta property="og:image" content="https://lxx741.github.io/front-end-history/favicon.svg">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="前端发展史 - 互动时间轴">
  <meta name="twitter:description" content="从1990到2025，涵盖技术标准、框架、浏览器与重要里程碑的前端发展史互动时间轴。">
  <meta name="twitter:image" content="https://lxx741.github.io/front-end-history/favicon.svg">
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "前端发展史 - 互动时间轴",
      "description": "从1990到2025，涵盖技术标准、框架、浏览器与重要里程碑的前端发展史互动时间轴。",
      "url": "https://lxx741.github.io/front-end-history/",
      "inLanguage": "zh-CN",
      "isPartOf": {
        "@type": "WebSite",
        "url": "https://lxx741.github.io/"
      }
    }
  </script>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-purple-50 min-h-screen">
  <!-- Animated Background -->
  <Background />
  
  <!-- Enhanced Floating Particles -->
  <div id="particles" class="fixed inset-0 pointer-events-none" style="z-index: 2;">
    <div class="particle floating-particle w-2 h-2 bg-blue-400 rounded-full" style="top: 10%; left: 10%; animation-delay: 0s;"></div>
    <div class="particle floating-particle w-3 h-3 bg-purple-400 rounded-full" style="top: 20%; left: 80%; animation-delay: 1s;"></div>
    <div class="particle floating-particle w-2 h-2 bg-pink-400 rounded-full" style="top: 60%; left: 20%; animation-delay: 2s;"></div>
    <div class="particle floating-particle w-4 h-4 bg-green-400 rounded-full" style="top: 80%; left: 70%; animation-delay: 3s;"></div>
    <div class="particle floating-particle w-2 h-2 bg-yellow-400 rounded-full" style="top: 40%; left: 50%; animation-delay: 4s;"></div>
    <div class="particle floating-particle w-3 h-3 bg-indigo-400 rounded-full" style="top: 30%; left: 30%; animation-delay: 5s;"></div>
    <div class="particle floating-particle w-2 h-2 bg-red-400 rounded-full" style="top: 70%; left: 60%; animation-delay: 6s;"></div>
  </div>

  <!-- Header -->
  <header class="relative z-10 text-center py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-5xl md:text-7xl font-bold bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 bg-clip-text text-transparent mb-4 animate-fade-in">
        前端发展史
      </h1>
      <p class="text-xl md:text-2xl text-gray-600 animate-slide-up">
        从静态页面到智能应用的演变之旅
      </p>
      <div class="mt-8 flex justify-center flex-wrap gap-2">
        <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">1990-2025</span>
        <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm">35年进化</span>
        <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm">技术革新</span>
      </div>
    </div>
  </header>

  <!-- Enhanced Header with Search -->
  <div class="relative z-10 sticky top-0 bg-white/80 backdrop-blur-md border-b border-gray-200 py-4 px-4 sticky-header transition-shadow duration-300">
    <div class="max-w-6xl mx-auto">
      <!-- Search Bar -->
      <div class="max-w-md mx-auto mb-4">
        <div class="relative">
          <label for="search-input" class="sr-only">搜索事件</label>
          <input 
            id="search-input"
            type="text" 
            placeholder="搜索事件... (Ctrl+F)"
            class="w-full px-4 py-2 pl-10 pr-4 text-gray-700 bg-white border border-gray-300 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            aria-label="搜索事件"
          />
          <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
      
      <!-- Filter Controls -->
      <div class="flex flex-wrap justify-center gap-2 mb-4">
        <button class="filter-btn px-4 py-2 rounded-full bg-gray-200 hover:bg-gray-300 transition-colors" data-category="all" aria-pressed="false" aria-label="全部">
          全部
        </button>
        {Object.entries(CATEGORIES).map(([key, config]) => (
          <button 
            class="filter-btn px-4 py-2 rounded-full transition-colors" 
            style="background-color: {config.bgColor}; color: {config.color};"
            data-category={key}
            aria-pressed="false"
            aria-label={`筛选：${config.label}`}
          >
            {config.label}
          </button>
        ))}
      </div>
      
      <!-- Quick Actions & Stats -->
      <div class="flex justify-center items-center gap-4 text-sm text-gray-600">
        <div>
          <span id="visible-count" class="font-bold text-blue-600">{years.reduce((acc, year) => acc + year.events.length, 0)}</span> 
          <span> 个事件</span>
        </div>
        <div class="text-gray-400">|</div>
        <button onclick="exportTimeline()" class="hover:text-blue-600 transition-colors" title="导出时间线数据">
          📥 导出
        </button>
        <div class="text-gray-400">|</div>
        <div class="text-xs text-gray-500">
          按 1-7 快速切换分类
        </div>
      </div>
    </div>
  </div>

  <!-- Main Timeline -->
  <main class="relative z-10 max-w-6xl mx-auto px-4 py-12">
    <div class="relative">
      <!-- Vertical Timeline Line -->
      <div class="timeline-line absolute left-1/2 transform -translate-x-1/2 w-1 h-full rounded-full"></div>
      
      <!-- Timeline Events -->
      {years.map((yearData, yearIndex) => (
        <div class="timeline-year mb-16" data-year={yearData.year}>
          <!-- Year Marker -->
          <div class="year-marker sticky top-24 z-20 inline-block mx-auto mb-8 px-6 py-3 rounded-full text-white font-bold text-xl shadow-lg">
            {yearData.year} 年
          </div>
          
          <!-- Events for this year -->
          {yearData.events.map((event, eventIndex) => {
            const isLeft = eventIndex % 2 === 0;
            const categoryConfig = CATEGORIES[event.category];
            const eraColor = getEraColor(yearData.year);
            const importanceClass = getImportanceClasses(event.importance);
            
            return (
              <div 
                class={`timeline-event event-card relative mb-12 ${isLeft ? 'md:mr-auto md:ml-0 md:pr-16 md:text-right' : 'md:ml-auto md:mr-0 md:pl-16'} ${importanceClass}`}
                data-category={event.category}
                data-importance={event.importance}
                data-index={eventIndex}
                style={isLeft ? {} : {}}
              >
                <!-- Connecting line to timeline -->
                <div class={`absolute top-1/2 transform -translate-y-1/2 w-8 h-1 bg-gradient-to-r ${isLeft ? 'from-transparent to-gray-300 right-full' : 'from-gray-300 to-transparent left-full'}`}></div>
                
                <!-- Event content -->
                <div class="relative">
                  <!-- Icon -->
                  <div class={`absolute ${isLeft ? '-right-2' : '-left-2'} top-1/2 transform -translate-y-1/2 w-12 h-12 bg-white rounded-full border-4 border-gray-300 flex items-center justify-center text-2xl shadow-md`}>
                    {getCategoryIcon(event)}
                  </div>
                  
                  <!-- Event details -->
                  <div class="pl-4 pr-4">
                    <h3 class="font-bold mb-2">{event.title}</h3>
                    <p class="text-sm opacity-90 leading-relaxed">{event.description}</p>
                    
                    <!-- Category badge -->
                    <div class={`mt-3 inline-block px-2 py-1 rounded text-xs font-medium`} style="background-color: {categoryConfig.bgColor}; color: {categoryConfig.color};">
                      {categoryConfig.label}
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      ))}
    </div>
  </main>

  <!-- Mobile Bottom Navigation -->
  <div class="fixed bottom-4 left-4 right-4 z-30 block lg:hidden">
    <div class="bg-white/90 backdrop-blur-md border border-gray-200 shadow-lg rounded-full px-3 py-2 flex items-center gap-2">
      <button 
        class="px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm border border-gray-200"
        onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
        aria-label="返回顶部"
      >
        返回顶部
      </button>
      <div class="flex-1 flex items-center gap-2">
        <label for="year-select" class="text-xs text-gray-600">跳转年份</label>
        <select 
          id="year-select" 
          class="flex-1 px-3 py-1 rounded-full bg-white border border-gray-300 text-sm"
          onchange="scrollToYear(this.value)"
          aria-label="选择年份并跳转"
        >
          {years.map((y) => (
            <option value={y.year}>{y.year}</option>
          ))}
        </select>
      </div>
    </div>
  </div>
 
  <!-- Quick Navigation -->
  <QuickNav />

  <!-- Footer -->
  <footer class="relative z-10 bg-gray-900 text-white py-8 px-4 mt-20">
    <div class="max-w-6xl mx-auto text-center">
      <p class="mb-2">🚀 前端发展史时间轴</p>
      <p class="text-sm text-gray-400">记录技术的每一次飞跃与变革</p>
      <div class="mt-4 flex justify-center gap-4 text-xs text-gray-500">
        <span>1990-2025</span>
        <span>•</span>
        <span>35年技术演进</span>
        <span>•</span>
        <span>使用 Astro + Tailwind 构建</span>
      </div>
    </div>
  </footer>

  <script type="module" src="/js/timeline.js"></script>
</body>
</html>
